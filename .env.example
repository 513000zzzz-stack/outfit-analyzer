# 在现有 .env 中补齐这些配置，保留你的 ARK_API_KEY 和 ARK_MODEL。
# 两个密码建议用不同的随机十六进制值，分别运行一次生成命令。
# python -c "import secrets; print(secrets.token_hex(32))"
DB_PASSWORD=
JWT_SECRET=

ARK_API_KEY=
ARK_MODEL=

# 在 Linux 服务器上，权重文件默认放在项目的 models/best.pt。
WEIGHTS_FILE=./models/best.pt
YOLO_DEVICE=cpu
WEB_PORT=8080

# 日志级别：DEBUG / INFO / WARNING / ERROR（默认 INFO）。
# 需要额外写文件时设置 LOG_FILE，例如 ./logs/api.log，按 10 MB 轮转保留 3 份。
LOG_LEVEL=INFO
# LOG_FILE=./logs/api.log
